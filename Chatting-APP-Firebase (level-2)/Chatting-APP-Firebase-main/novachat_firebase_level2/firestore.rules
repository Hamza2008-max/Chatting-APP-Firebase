rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isRoomParticipant(roomData) {
      return signedIn()
        && roomData.participants is list
        && roomData.participants.size() == 2
        && myEmail() in roomData.participants;
    }

    // Private user profile. A user can only access their own profile document.
    match /users/{email} {
      allow create: if signedIn()
        && email == myEmail()
        && request.resource.data.email == myEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'uid', 'createdAt']);
      allow get, list: if signedIn() && email == myEmail();
      allow update: if signedIn()
        && email == myEmail()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['name', 'email', 'uid', 'createdAt']);
      allow delete: if false;
    }

    // Minimal email-only directory. Authenticated clients may get a known email
    // document to validate a recipient, but cannot list/enumerate the directory.
    match /userDirectory/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && email == myEmail()
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == myEmail();
      allow update, delete: if false;
    }

    match /chats/{roomId} {
      allow get: if isRoomParticipant(resource.data);
      allow list: if signedIn()
        && resource.data.participants is list
        && myEmail() in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && myEmail() in request.resource.data.participants
        && request.resource.data.updatedAt == request.time;

      allow update: if isRoomParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        function parentRoom() {
          return get(/databases/$(database)/documents/chats/$(roomId)).data;
        }

        allow get, list: if isRoomParticipant(parentRoom());

        allow create: if isRoomParticipant(parentRoom())
          && request.resource.data.keys().hasOnly(['sender', 'text', 'createdAt'])
          && request.resource.data.sender == myEmail()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
